# Copy to .env and fill in. Never commit .env.

# SEC requires a declared User-Agent: "Name email@domain"
SEC_USER_AGENT="Your Name your.email@example.com"

# LLM: openai (default) | azure | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (Ollama, vLLM...)
# AZURE_OPENAI_ENDPOINT= / AZURE_OPENAI_API_KEY= / OPENAI_API_VERSION=   (LLM_MODEL = deployment name)
# ANTHROPIC_API_KEY=                           # with LLM_PROVIDER=anthropic; embeddings still via EMBED_PROVIDER
EMBED_MODEL=text-embedding-3-small

# Neo4j: local Docker (docker compose up -d) or Aura (neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=demo-password

# Optional
# TICKERS=AAPL,MSFT,NVDA,AMZN,GOOGL,INTC,PYPL,PCG,MCD,AIG
# CORPUS=edgar_latest          # or workshop_sample
# LLM_CACHE=readwrite          # replay = offline, fail on cache miss
