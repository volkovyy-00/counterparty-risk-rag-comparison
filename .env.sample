# Copy to .env and fill in. Never commit .env (it is git-ignored; run `make check-secrets`).

# SEC requires a declared User-Agent: "Name email@domain"
SEC_USER_AGENT="Your Name your.email@example.com"

# LLM: anthropic (default) | openai | azure
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# LLM_EFFORT=low
# OPENAI_API_KEY=  /  OPENAI_BASE_URL=http://localhost:11434/v1   (any OpenAI-compatible server; LLM_STRUCTURED=json)
# AZURE_OPENAI_ENDPOINT= / AZURE_OPENAI_API_KEY= / OPENAI_API_VERSION=   (LLM_MODEL = deployment name)

# Embeddings: local (default, fastembed on CPU, model downloaded once) | openai | azure
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIMENSIONS=384

# Neo4j (build time only): local Docker (docker compose up -d) or Aura (neo4j+s://<id>.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=demo-password      # local-only default, matches docker-compose.yml

# Optional
# GROUP=auto_semis             # semis_tech | legacy_mixed (groups.yaml); TICKERS=... overrides
# CORPUS=edgar_latest          # or workshop_sample
# LLM_CACHE=readwrite          # replay = offline, fail on cache miss
